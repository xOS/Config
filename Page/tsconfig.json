{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "charset": "utf8",
    "outDir": "./dist",
    "skipLibCheck": true
  },
  "ts-node": {
    "esm": true // 支持 "type": "module"
  }
}
