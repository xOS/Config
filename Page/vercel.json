{
  "version": 2,
  "installCommand": "yarn install",
  "buildCommand": "yarn run build",
  "outputDirectory": "../public",
  "headers": [
        {
            "source": "/*.js",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/javascript; charset=utf-8"
                }
            ]
        },
        {
            "source": "/*.conf",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/*.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json; charset=utf-8"
                }
            ]
        },
        {
            "source": "/*.dconf",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/*.list",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/*.sgmodule",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        }
    ],
  "routes": [
    {
      "src": "/(RuleSet|Module|Mock|MitM|IconSet|GeoIP|Script|static)/.*"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app/.*",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}