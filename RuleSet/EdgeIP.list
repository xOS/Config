# > 发微博触发IP识别
# >> APP 端
URL-REGEX,^https?:\/\/api\.weibo\.c(n|om)\/2\/statuses\/send\?,extended-matching
# >> 网页端
URL-REGEX,^https?:\/\/weibo\.c(n|om)\/ajax\/statuses\/update,extended-matching
URL-REGEX,^https?:\/\/weibo\.c(n|om)\/2\/client\/publisher_primary,extended-matching

# > 评论触发IP识别
# >> APP 端
URL-REGEX,^https?:\/\/api\.weibo\.c(n|om)\/2\/comments\/create\?,extended-matching
# >> 网页端
URL-REGEX,^https?:\/\/weibo\.c(n|om)\/ajax\/comments\/create,extended-matching

# > 微信公众平台
DOMAIN-SUFFIX,mp.weixin.qq.com,extended-matching

