http-response-jq ^https?:\/\/tiebac?\.baidu\.com\/c\/f\/sidebar\/home 'del(.game_center, .vip_banner, .task_list) | if has("tools") and (.tools | type == "object") then .tools.all_tools_list |= map(select(.title != "度小满钱包")) | .tools.yunying_tools_list |= map(select(.title != "度小满钱包")) | .tools.show_tools_list |= map(if has("tools_list") and (.tools_list | type == "array") then .tools_list |= map(select(.title != "度小满钱包")) else . end) else . end | walk(if type == "object" and has("sub_type") and .sub_type == "not_vip" then .sub_type = "svip" else . end)'

