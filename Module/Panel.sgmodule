#!name=信息面板
#!desc=日用夜用
#!category=翠花|本地
#!arguments=GeoIPApi:ping0,EnableIPv6:1
#!arguments-desc= 接口说明：\nApi 可选值：[muhan, quic, pingan, ipip, bilibili, ping0]\nEnableIPv6 可选值：[0, 1, true]\n - 0: 关闭\n - 1: 开启\n - true: 默认，开启

[Panel]
# > 黄历
黄历 = script-name=黄历,title=今日黄历,content=请刷新,style=info,update-interval=3600

# > 网络状态
网络状态 = title="网络状态",content="请刷新",style=info,update-interval=360,script-name=网络状态

# > 倒数日
倒数日 = title="倒数日",content="请刷新",icon=tray.and.arrow.down.fill,icon-color="#9978FF",update-interval=120,script-name=倒数日

[Script]
# > 网络信息
网络状态 = type=generic, script-path=https://rule.quic.me/Script/Tools/NetInfo.js,argument="GeoIPApi={{{GeoIPApi}}}&EnableIPv6={{{EnableIPv6}}}"

# > 倒数日
倒数日 = type=generic, script-path=https://rule.quic.me/Script/Tools/Days.js

# > 黄历
黄历 = type = generic,script-path=https://rule.quic.me/Script/Tools/wnCalendar.js,timeout=10
