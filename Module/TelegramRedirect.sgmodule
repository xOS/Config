#!name=Telegram Redirect
#!desc=Telegram 链接跳转到第三方客户端
#!category=春夏
#!arguments=Scheme:tg
#!arguments-desc=Scheme 可选值：\n - tg: Telegram，默认\n - sg: Swiftgram\n - turrit: Turrit\n - ayu: AyuGram\n - ime: iMe\n - ng: Nicegram\n - lingo: Lingogram\n


[URL Rewrite]
# > Telegram 跳转第三方客户端
^https?:\/\/t\.me\/(.+) {{{Scheme}}}://resolve?domain=$1 307


[MITM]
hostname = %APPEND% t.me:0
